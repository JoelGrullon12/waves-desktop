# Development overrides only: a packaged build is configured from Settings (the
# values are kept encrypted in its data folder). A value set here wins over the
# saved one. TIDAL: set BOTH to skip the first-launch prompt in dev.
# Credentials come from https://developer.tidal.com/dashboard
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Optional: override the SQLite file path (defaults to the data folder)
LOCAL_SQLITE_PATH=

# Cloud copy of the play counts (Turso). Leave both empty to use the one saved in Settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port of the phone remote (default 47836)
REMOTE_CONTROL_WEBSOCKET_PORT=
