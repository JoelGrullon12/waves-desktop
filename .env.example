# Development override only. Packaged builds ask for the TIDAL credentials on
# first launch and store them encrypted; set BOTH to skip that prompt in dev.
# Credentials come from https://developer.tidal.com/dashboard
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Optional: override the SQLite file path (defaults to the Electron userData dir)
LOCAL_SQLITE_PATH=

# Cloud copy of the play counts (Turso). Leave both empty to keep them on this device only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Port of the phone remote (default 47836)
REMOTE_CONTROL_WEBSOCKET_PORT=
